# Copy to .env and fill in. NEVER commit .env.

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview
AZURE_OPENAI_REALTIME_FALLBACK_DEPLOYMENT=gpt-4o-realtime-preview

# Leave empty in Azure (use Managed Identity); set for local dev only.
AZURE_OPENAI_API_KEY=

# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Telemetry (optional) ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
